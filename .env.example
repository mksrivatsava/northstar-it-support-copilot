# Copy to .env. Empty admin key generates a random key in .runtime/admin-key.
APP_ADMIN_KEY=
# Neon: pooled app URL and direct migration URL. Never commit actual values.
# With DATABASE_URL set, PostgreSQL is selected unless explicitly overridden.
DATABASE_URL=
DATABASE_URL_POOLED=
DATABASE_URL_UNPOOLED=
POSTGRES_SCHEMA=northstar
# Optional local rollback: PERSISTENCE_BACKEND=sqlite
# extractive works offline; gemini uses the Gemini API; ollama uses a local model.
ANSWER_MODE=extractive
RETRIEVAL_MODE=sqlite
# Enable both Gemini generation and Pinecone retrieval by setting:
# ANSWER_MODE=gemini and RETRIEVAL_MODE=pinecone
GEMINI_API_KEY=
PINECONE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
PINECONE_INDEX=northstar-support-gemini-768
PINECONE_NAMESPACE=northstar-local-v1
VECTOR_MIN_SCORE=0.55
CLOUD_TIMEOUT=45
GEMINI_REQUEST_TIMEOUT=20
GEMINI_TOTAL_TIMEOUT=50
GEMINI_MAX_ATTEMPTS=3
# Optional public vendor web search. No original user text or private passages
# are submitted to Tavily; only approved product/topic query templates.
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
WEB_REQUEST_TIMEOUT=10
WEB_TOTAL_TIMEOUT=20
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=45
APP_PORT=8000
